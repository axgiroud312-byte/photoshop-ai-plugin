{
  "manifestVersion": 5,
  "id": "com.axgiroud312.photoshop-ai",
  "name": "AI 图层编辑",
  "version": "0.0.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0",
    "data": { "apiVersion": 2 }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiLayerEdit",
      "label": { "default": "AI 图层编辑" },
      "minimumSize": { "width": 320, "height": 520 },
      "maximumSize": { "width": 720, "height": 2400 },
      "preferredDockedSize": { "width": 360, "height": 760 },
      "preferredFloatingSize": { "width": 420, "height": 760 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:47833"]
    },
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": false
  }
}
